@model MyMovies.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<div class="mb-4">
    <h1 class="display-6 fw-bold text-danger">Delete Movie</h1>
    <h5 class="text-secondary">Are you sure you want to delete this movie from the database?</h5>
</div>

<div class="card bg-dark text-white border-danger mb-4" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-secondary">Title</dt>
            <dd class="col-sm-8 fw-bold">@Model.Title</dd>

            <dt class="col-sm-4 text-secondary">Genre</dt>
            <dd class="col-sm-8">@Model.Genre</dd>

            <dt class="col-sm-4 text-secondary">Rating</dt>
            <dd class="col-sm-8">@Model.Rating</dd>

            <dt class="col-sm-4 text-secondary">Release Date</dt>
            <dd class="col-sm-8">@Model.ReleaseDate.ToString("MMM dd, yyyy")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger me-2">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>