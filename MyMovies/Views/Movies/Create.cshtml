@model MyMovies.Models.Movie

@{
    ViewData["Title"] = "Add New Movie";
}

<div class="mb-4">
    <h1 class="display-6 fw-bold" style="color: var(--brand-red);">Add New Movie</h1>
    <p class="text-secondary">Enter movie details to add to the catalog</p>
</div>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold"></label>
                <input asp-for="Title" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Genre" class="form-label fw-bold"></label>
                <input asp-for="Genre" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Action, Sci-Fi" />
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Rating" class="form-label fw-bold"></label>
                    <input asp-for="Rating" class="form-control bg-dark text-white border-secondary" placeholder="e.g. PG-13, R" />
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="RunTime" class="form-label fw-bold"></label>
                    <input asp-for="RunTime" class="form-control bg-dark text-white border-secondary" placeholder="e.g. 2h 28m" />
                    <span asp-validation-for="RunTime" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ReleaseDate" class="form-label fw-bold"></label>
                <input asp-for="ReleaseDate" class="form-control bg-dark text-white border-secondary" type="date" />
                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Synopsis" class="form-label fw-bold"></label>
                <textarea asp-for="Synopsis" class="form-control bg-dark text-white border-secondary" rows="3"></textarea>
                <span asp-validation-for="Synopsis" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2">Save Movie</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}