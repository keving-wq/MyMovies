@model IEnumerable<MyMovies.Models.Movies>
@{
    ViewData["Title"] = "Rate MyMovies";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Movies</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add New Movie</a>
    </div>

    <p class="text-muted">critics dashboard for updating database.</p>

    <table class="table table-striped table-hover border">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Genre</th>
                <th>Release Date</th>
                <th>Director</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movies in Model)
            {
                <tr>
                    <td class="fw-bold">@movies.Title</td>
                    <td><span class="badge bg-secondary">@movies.Genre</span></td>
                    <td>@movies.ReleaseDate.ToString("yyyy-MM-dd")</td>
                    <td>@movies.Director</td>
                    <td class="text-end">
                        <a href="#" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a href="#" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>