@model IEnumerable<MyMovies.Models.Movie>

@{
    ViewData["Title"] = "Movie Administration";
}

<div class="container my-4">
    <h2>Movie List</h2>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Genre</th>
                <th>Run Time</th>
                <th>Rating</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Genre</td>
                    <td>@item.RunTime</td>
                    <td>@item.Rating</td>
                </tr>
            }
        </tbody>
    </table>
</div>